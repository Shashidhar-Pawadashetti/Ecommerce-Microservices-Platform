# Catalog Service environment — variable NAMES mirror the root .env / .env.example
# exactly (contractual: never rename or repurpose existing keys). Values are
# placeholders; copy to .env for local runs (or rely on the root .env via Compose).

# ── Auth / JWT (issued by auth-service, verified by api-gateway; catalog is a
#    v1 self-verify holder per deviation DOCS-02) ──────────────────────────────
JWT_SECRET=<long-random-secret-change-me>
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_TTL_SECONDS=3600

# ── Datastore ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017
