# ══════════════════════════════════════════════════════════════════════
#  Ecommerce Microservices Platform — environment template
#
#  POLICY:
#    • Variable NAMES are contractual — later phases ADD variables,
#      never rename or repurpose existing ones.
#    • Every value below is a PLACEHOLDER. Copy this file to .env for
#      local values:  cp .env.example .env
#    • NEVER commit .env — it is gitignored from commit one.
# ══════════════════════════════════════════════════════════════════════

# ── Event bus (Apache Kafka, KRaft mode, single broker) ──────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Auth / JWT (issued by auth-service, verified by api-gateway) ─────
JWT_SECRET=<long-random-secret-change-me>
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_TTL_SECONDS=3600

# ── Payments (mock authorization mode per ORDR-03) ───────────────────
#    One of: always_success | always_fail | random
PAYMENT_MODE=always_success

# ── Cart expiry (Redis TTL for cart keys, default 14 days) ───────────
CART_TTL_SECONDS=1209600

# ── Internal service URLs (Docker-network DNS names) ─────────────────
CATALOG_SERVICE_URL=http://catalog-service:8000
CART_SERVICE_URL=http://cart-service:3001

# ── SMTP (consumed by Mailpit, the mock SMTP per approved deviation D-07;
#    UI at :8025, REST assertion surface /api/v1/messages) ────────────
SMTP_HOST=mailpit
SMTP_PORT=1025

# ── Datastores ────────────────────────────────────────────────────────
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-db-password
MONGO_URI=mongodb://mongo:27017
REDIS_URL=redis://redis:6379/0
